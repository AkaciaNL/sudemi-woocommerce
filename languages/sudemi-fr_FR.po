msgid "Download these orders (CSV)"
msgstr "Télécharger ces commandes (CSV)"

msgid "Every order that matches the filters, up to 10,000, without buyer names or addresses."
msgstr "Toutes les commandes qui correspondent aux filtres, jusqu’à 10 000, sans noms ni adresses des acheteurs."

msgid "Confirm orders automatically when the items are in stock"
msgstr "Confirmer automatiquement les commandes quand les articles sont en stock"

msgid "Save"
msgstr "Enregistrer"

msgid "On: every five minutes this shop accepts orders whose items are in stock and declines the others."
msgstr "Activé : toutes les cinq minutes, cette boutique accepte les commandes dont les articles sont en stock et refuse les autres."

msgid "Off: orders wait for you. Accept or decline each one here before the date shown; without an answer the buyer is released and charged nothing."
msgstr "Désactivé : les commandes vous attendent. Acceptez ou refusez chacune ici avant la date indiquée ; sans réponse, l’acheteur est libéré et rien n’est débité."

msgid "Back to the orders"
msgstr "Retour aux commandes"

#, php-format
msgid "Order %1$s: %2$s"
msgstr "Commande %1$s : %2$s"

#, php-format
msgid "Waiting for your answer. The buyer is not charged until you accept. Answer by %s; without an answer the buyer is released."
msgstr "En attente de votre réponse. L’acheteur n’est débité que lorsque vous acceptez. Répondez avant le %s ; sans réponse, l’acheteur est libéré."

#, php-format
msgid "Stock check: %s."
msgstr "Vérification du stock : %s."

msgid "sudemi order"
msgstr "Commande sudemi"

msgid "Placed"
msgstr "Passée le"

msgid "none yet (it is created when the order is accepted)"
msgstr "pas encore (elle est créée quand la commande est acceptée)"

msgid "Buyer may withdraw until"
msgstr "L’acheteur peut se rétracter jusqu’au"

msgid "Reason declined"
msgstr "Motif du refus"

