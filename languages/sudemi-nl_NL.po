msgid "Download these orders (CSV)"
msgstr "Deze bestellingen downloaden (CSV)"

msgid "Every order that matches the filters, up to 10,000, without buyer names or addresses."
msgstr "Elke bestelling die aan de filters voldoet, tot 10.000, zonder namen of adressen van kopers."

msgid "Confirm orders automatically when the items are in stock"
msgstr "Bestellingen automatisch bevestigen als de artikelen op voorraad zijn"

msgid "Save"
msgstr "Opslaan"

msgid "On: every five minutes this shop accepts orders whose items are in stock and declines the others."
msgstr "Aan: elke vijf minuten accepteert deze winkel bestellingen waarvan de artikelen op voorraad zijn en wijst de andere af."

msgid "Off: orders wait for you. Accept or decline each one here before the date shown; without an answer the buyer is released and charged nothing."
msgstr "Uit: bestellingen wachten op jou. Accepteer of wijs elke bestelling hier af vóór de getoonde datum; zonder antwoord wordt de koper vrijgegeven en wordt er niets afgeschreven."

msgid "Back to the orders"
msgstr "Terug naar de bestellingen"

#, php-format
msgid "Order %1$s: %2$s"
msgstr "Bestelling %1$s: %2$s"

#, php-format
msgid "Waiting for your answer. The buyer is not charged until you accept. Answer by %s; without an answer the buyer is released."
msgstr "Wacht op je antwoord. Er wordt pas iets bij de koper afgeschreven als je accepteert. Antwoord vóór %s; zonder antwoord wordt de koper vrijgegeven."

#, php-format
msgid "Stock check: %s."
msgstr "Voorraadcontrole: %s."

msgid "sudemi order"
msgstr "sudemi-bestelling"

msgid "Placed"
msgstr "Geplaatst"

msgid "none yet (it is created when the order is accepted)"
msgstr "nog geen (die wordt aangemaakt als de bestelling wordt geaccepteerd)"

msgid "Buyer may withdraw until"
msgstr "Koper kan herroepen tot"

msgid "Reason declined"
msgstr "Reden van afwijzing"

